# Copy to .env for local runs. On Render, set these under Environment.
ENVIRONMENT=development
# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Leave empty unless your project still uses the legacy JWT secret (HS256).
SUPABASE_JWT_SECRET=
# Comma-separated web origins allowed to call the API (your Vercel URL in production)
ALLOWED_ORIGINS=http://localhost:3000
