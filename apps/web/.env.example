# Copy to .env.local for local development. Never commit real values.
# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Public URL of the FastAPI service on Render (used from M3 onward)
NEXT_PUBLIC_API_URL=http://localhost:8000
